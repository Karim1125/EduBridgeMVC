@model EduBridgeMVC.Contracts.Authentication.ForgetPasswordRequest

@{
    ViewData["Title"] = "Forgot Password";
}
@{
    Layout = null;
}
<div class="container d-flex justify-content-center align-items-center"
     style="background:linear-gradient(135deg,#ede9fe,#f5f3ff); min-height:100vh; display:flex; align-items:center; justify-content:center;">

    <div class="card shadow-lg p-4"
         style="max-width:400px; width:100%; padding:40px; border-radius:25px; background: rgba(255,255,255,0.4); border:2px dashed #7e22ce; backdrop-filter: blur(20px); box-shadow:0 10px 40px rgba(139,92,246,0.2); position:relative; overflow:hidden;">
        <h3 style="
            text-align:center;
            margin-bottom:25px;
            font-size:28px;
            font-weight:bold;
            background: linear-gradient(90deg,#a855f7,#d946ef,#9333ea);
            -webkit-background-clip:text;
            -webkit-text-fill-color:transparent;
            ">
            Forgot Password 🔐</h3>

            <p class="text-center" style="color:#6b21a8;">
                Enter your email and we’ll send you a reset link
            </p>

            <form asp-action="ForgetPassword" method="post">
                <div style="margin-top:20px;">
                    <input asp-for="Email" placeholder="Email" onfocus="this.style.borderBottom='2px solid #a855f7'"
                           onblur="this.style.borderBottom='2px solid #7e22ce'"
                           style="width:100%; border:none; border-bottom:2px solid #7e22ce; background:transparent; padding:10px; outline:none; color:#6b21a8;"
                           class="form-control" />
                </div>
                <button type="submit" onmouseover="this.style.transform='scale(1.05)'"
                        onmouseout="this.style.transform='scale(1)'" onmousedown="this.style.transform='scale(0.95)'"
                        onmouseup="this.style.transform='scale(1.05)'" style="
                    width:100%;
                    margin-top:30px;
                    padding:13px;
                    border:none;
                    border-radius:14px;
                    font-weight:bold;
                    cursor:pointer;
                    background: linear-gradient(90deg,#7e22ce,#a855f7,#9333ea);
                    color:white;
                    transition:0.2s;
                    ">
                    Reset Password
                </button>
            </form>

            <div asp-validation-summary="All" class="text-danger mt-3"></div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success text-center mt-3">
                    @TempData["Success"]
                </div>
            }

            <div style="text-align:center; margin-top:18px;">
                <span style="color:#6b21a8;">Back To</span>
                <a asp-controller="Auth" asp-action="Login" style="
                    background: linear-gradient(90deg,#a855f7,#d946ef,#9333ea);
                    -webkit-background-clip:text;
                    -webkit-text-fill-color:transparent;
                    font-weight:bold;
                    text-decoration:none;
                    ">
                    Login
                </a>
                <span style="color:#6b21a8;">Page</span>
            </div>

        </div>

    </div>


    <partial name="_ValidationScriptsPartial" />