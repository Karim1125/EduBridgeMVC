@model EduBridgeMVC.Contracts.Authentication.RegisterRequest

@{
    ViewData["Title"] = "Register";
}

<!-- bradcam_area_start -->
<div class="bradcam_area breadcam_bg overlay2" style="padding:150px 0;">
    <h3 style="font-style: italic;">Create Account</h3>
</div>
<!-- bradcam_area_end -->

<!-- Register Area -->
<div class="about_area" style="background:linear-gradient(135deg,#f5f3ff,#ddd6fe,#c4b5fd,#a78bfa);">
    <div class="container">
        <div class="row justify-content-center">

            <div class="col-xl-6 col-lg-8">

                <div class="single_about_info p-4 shadow" style="background:#fff; border-radius:15px; border:2px dashed #a855f7">
<h3 style="
    text-align:center;
    margin-bottom:25px;
    font-size:28px;
    font-weight:bold;
    background: linear-gradient(90deg,#a855f7,#d946ef,#9333ea);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
">
    EduBridge 🚀
</h3>

<form asp-action="Register" method="post" enctype="multipart/form-data"
      style="
        max-width:520px;
        margin:auto;
        padding:35px;
        border-radius:25px;
        background: rgba(255,255,255,0.07);
        backdrop-filter: blur(18px);
        border:1.5px solid rgba(168,85,247,0.4);
        box-shadow:0 0 25px rgba(168,85,247,0.25);
        color:#6b21a8;
      ">

    <!-- Profile Image Upload -->
    <div style="text-align:center; margin-bottom:25px;">
        <div style="position:relative; display:inline-block;">
            <img id="previewAvatar" src="/img/default.png"
                 style="width:110px;height:110px;border-radius:50%;object-fit:cover;
                        border:3px solid #a855f7;box-shadow:0 0 20px rgba(168,85,247,0.4);" />
            <label for="profileImageInput" title="Upload photo"
                   style="position:absolute;bottom:2px;right:2px;background:#7c3aed;
                   border-radius:50%;width:30px;height:30px;display:flex;align-items:center;
                   justify-content:center;cursor:pointer;border:2px solid white;">
                <span style="color:white;font-size:15px;">&#9998;</span>
            </label>
            <input id="profileImageInput" asp-for="ProfileImage" type="file" accept="image/*"
                   style="display:none;" onchange="previewImage(this)" />
        </div>
        <p style="margin:8px 0 0;font-size:13px;color:#7e22ce;">Profile photo (optional)</p>
    </div>

    <!-- Names -->
    <div style="display:flex; gap:10px;">
        <div style="flex:1;">
            <input asp-for="FirstName" placeholder="First Name"
                   onfocus="this.style.borderBottom='2px solid #a855f7'"
                   onblur="this.style.borderBottom='2px solid #7e22ce'"
                   style="width:100%; border:none; border-bottom:2px solid #7e22ce; background:transparent; padding:10px; outline:none; color:#6b21a8;" class="form-control" />
            <span asp-validation-for="FirstName" style="color:#dc2626; font-size:12px;"></span>
        </div>
        <div style="flex:1;">
            <input asp-for="LastName" placeholder="Last Name"
                   onfocus="this.style.borderBottom='2px solid #a855f7'"
                   onblur="this.style.borderBottom='2px solid #7e22ce'"
                   style="width:100%; border:none; border-bottom:2px solid #7e22ce; background:transparent; padding:10px; outline:none; color:#6b21a8;" class="form-control" />
            <span asp-validation-for="LastName" style="color:#dc2626; font-size:12px;"></span>
        </div>
    </div>

    <!-- Email -->
    <div style="margin-top:20px;">
        <input asp-for="Email" placeholder="Email"
               onfocus="this.style.borderBottom='2px solid #a855f7'"
               onblur="this.style.borderBottom='2px solid #7e22ce'"
               style="width:100%; border:none; border-bottom:2px solid #7e22ce; background:transparent; padding:10px; outline:none; color:#6b21a8;" class="form-control" />
        <span asp-validation-for="Email" style="color:#dc2626; font-size:12px;"></span>
    </div>

    <!-- Password -->
    <div style="margin-top:20px;">
        <input asp-for="Password" type="password" placeholder="Password"
               onfocus="this.style.borderBottom='2px solid #a855f7'"
               onblur="this.style.borderBottom='2px solid #7e22ce'"
               style="width:100%; border:none; border-bottom:2px solid #7e22ce; background:transparent; padding:10px; outline:none; color:#6b21a8;" class="form-control" />
        <span asp-validation-for="Password" style="color:#dc2626; font-size:12px;"></span>
    </div>

    <!-- Confirm -->
    <div style="margin-top:20px;">
        <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password"
               onfocus="this.style.borderBottom='2px solid #a855f7'"
               onblur="this.style.borderBottom='2px solid #7e22ce'"
               style="width:100%; border:none; border-bottom:2px solid #7e22ce; background:transparent; padding:10px; outline:none; color:#6b21a8;" class="form-control" />
        <span asp-validation-for="ConfirmPassword" style="color:#dc2626; font-size:12px;"></span>
    </div>

    <!-- Role -->
    <div style="margin-top:30px; text-align:center;">
        <p style="
            font-size:18px;
            font-weight:bold;
            margin-bottom:15px;
            background: linear-gradient(90deg,#7e22ce,#a855f7);
            -webkit-background-clip:text;
            -webkit-text-fill-color:transparent;
        ">
            Choose your role
        </p>

        <div style="display:flex; gap:10px;">
            <button type="button" onclick="selectRole(this,'Student')" class="roleBtn"
                    style="flex:1; padding:12px; border-radius:12px; border:1px solid #7e22ce;
                           background:transparent; color:#6b21a8; transition:0.3s;">
                Student
            </button>

            <button type="button" onclick="selectRole(this,'TA')" class="roleBtn"
                    style="flex:1; padding:12px; border-radius:12px; border:1px solid #7e22ce;
                           background:transparent; color:#6b21a8; transition:0.3s;">
                TA
            </button>

            <button type="button" onclick="selectRole(this,'Doctor')" class="roleBtn"
                    style="flex:1; padding:12px; border-radius:12px; border:1px solid #7e22ce;
                           background:transparent; color:#6b21a8; transition:0.3s;">
                Doctor
            </button>
        </div>

        <input type="hidden" asp-for="Role" id="roleInput" />
        <span asp-validation-for="Role" style="color:#dc2626; font-size:12px; display:block; margin-top:8px;"></span>
    </div>

    <!-- Security Code (shown only for TA/Doctor) -->
    <div id="securityCodeSection" style="margin-top:20px; display:none;">
        <input asp-for="SecurityCode" placeholder="Security Code"
               onfocus="this.style.borderBottom='2px solid #a855f7'"
               onblur="this.style.borderBottom='2px solid #7e22ce'"
               style="width:100%; border:none; border-bottom:2px solid #7e22ce; background:transparent; padding:10px; outline:none; color:#6b21a8;" class="form-control" />
        <span asp-validation-for="SecurityCode" style="color:#dc2626; font-size:12px;"></span>
    </div>

    <!-- Submit -->
    <button type="submit"
            onmouseover="this.style.transform='scale(1.05)'"
            onmouseout="this.style.transform='scale(1)'"
            onmousedown="this.style.transform='scale(0.95)'"
            onmouseup="this.style.transform='scale(1.05)'"
            style="
                width:100%;
                margin-top:30px;
                padding:13px;
                border:none;
                border-radius:14px;
                font-weight:bold;
                cursor:pointer;
                background: linear-gradient(90deg,#7e22ce,#a855f7,#9333ea);
                color:white;
                transition:0.2s;
            ">
        Register
    </button>

    <!-- Login -->
    <div style="text-align:center; margin-top:18px;">
        <span style="color:#6b21a8;">Already have an account?</span>
        <a asp-controller="Auth" asp-action="Login"
           style="
             background: linear-gradient(90deg,#a855f7,#d946ef,#9333ea);
             -webkit-background-clip:text;
             -webkit-text-fill-color:transparent;
             font-weight:bold;
             text-decoration:none;
           ">
            Login
        </a>
    </div>
    <div asp-validation-summary="All" class="text-danger mt-3"></div>
     @if (TempData["Success"] != null)
        {
            <div class="alert alert-success text-center mt-3">
                @TempData["Success"]
            </div>
        }
</form>
                </div>

            </div>

        </div>
    </div>
</div><!-- end about_area -->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
function previewImage(input) {
    if (input.files && input.files[0]) {
        var reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('previewAvatar').src = e.target.result;
        };
        reader.readAsDataURL(input.files[0]);
    }
}

function selectRole(btn, role) {
    document.getElementById("roleInput").value = role;

    let buttons = document.querySelectorAll(".roleBtn");
    buttons.forEach(b => {
        b.style.background = "transparent";
        b.style.color = "#6b21a8";
    });

    btn.style.background = "linear-gradient(90deg,#7e22ce,#a855f7,#9333ea)";
    btn.style.color = "white";

    // Show security code field for TA and Doctor roles
    var secSection = document.getElementById("securityCodeSection");
    if (role === "TA" || role === "Doctor") {
        secSection.style.display = "block";
    } else {
        secSection.style.display = "none";
    }
}
</script>

