@model EduBridgeMVC.Contracts.Doctor.DoctorResponse

<div class="bradcam_area breadcam_bg overlay2" style="padding: 150px 0;">
    <h3 style="font-style: italic;">Doctor Details</h3>
</div>

<div class="about_area" style="min-height:100vh;
    background:linear-gradient(135deg,#f5f3ff,#ede9fe,#ddd6fe);
    display:flex;align-items:center;justify-content:center;padding:50px 0;">

    <div id="toast-ajax" style="display:none; position:fixed;top:100px;left:50%;transform:translateX(-50%);
        z-index:9999;background:#7e22ce;color:white;padding:14px 30px;border-radius:20px;font-weight:bold;"></div>

    <div style="width:560px;border-radius:24px;padding:35px;
        background:linear-gradient(135deg,#35265f,#4c1d95);
        border:4px dotted #a855f7;
        box-shadow:0 20px 50px rgba(91,33,182,0.35);color:white;">

        <!-- Avatar + Image Upload -->
        <div style="text-align:center;margin-bottom:20px;">
            <div style="position:relative;display:inline-block;">
                <img id="doctor-avatar" src="@(Model.ProfileImageUrl ?? "/img/default.png")"
                     style="width:115px;height:115px;border-radius:50%;object-fit:cover;
                     border:3px solid #c4b5fd;box-shadow:0 0 22px rgba(196,181,253,0.6);" />
                <label for="imgUpload" title="Change photo"
                       style="position:absolute;bottom:0;right:0;background:#7c3aed;
                       border-radius:50%;width:30px;height:30px;display:flex;align-items:center;
                       justify-content:center;cursor:pointer;border:2px solid white;">
                    <span style="color:white;font-size:15px;">&#9998;</span>
                </label>
                <input id="imgUpload" type="file" accept="image/*" style="display:none;"
                       onchange="uploadImage(this, '@Model.Id')" />
            </div>
            <h2 style="margin-top:15px;font-size:28px;font-weight:700;color:#ffffff;">@Model.FullName</h2>
            <p style="color:#e9d5ff;font-size:15px;margin:0;">@Model.Email</p>
            @if (Model.AcademicTitle != null)
            {
                <p style="color:#c4b5fd;font-size:14px;margin:4px 0;">@Model.AcademicTitle</p>
            }
        </div>

        <hr style="border-color:rgba(196,181,253,0.15);">

        <div style="font-size:17px;line-height:2;margin-top:15px;">
            <p><span style="color:#d8b4fe;font-weight:500;">Department:</span>
               <span style="color:#ffffff;font-weight:500;">@Model.Department</span></p>
            @if (Model.OfficeLocation != null)
            {
                <p><span style="color:#d8b4fe;font-weight:500;">Office:</span>
                   <span style="color:#ffffff;font-weight:500;">@Model.OfficeLocation</span></p>
            }
            <p><span style="color:#d8b4fe;font-weight:500;">Teams:</span>
               <span style="color:#ffffff;font-weight:500;">@Model.AvailableTeams available / @Model.MaxTeams max</span></p>
            <p>
                <span style="color:#d8b4fe;font-weight:500;">Status:</span>
                @if (Model.IsAvailable)
                {
                    <span style="background:#16a34a;color:white;font-size:13px;padding:3px 12px;border-radius:10px;font-weight:600;">Available</span>
                }
                else
                {
                    <span style="background:#64748b;color:white;font-size:13px;padding:3px 12px;border-radius:10px;font-weight:600;">Full</span>
                }
            </p>
            @if (Model.GitHubUrl != null)
            {
                <p><span style="color:#d8b4fe;font-weight:500;">GitHub:</span>
                   <a href="@Model.GitHubUrl" target="_blank" style="color:#a78bfa;">@Model.GitHubUrl</a></p>
            }
            @if (Model.LinkedInUrl != null)
            {
                <p><span style="color:#d8b4fe;font-weight:500;">LinkedIn:</span>
                   <a href="@Model.LinkedInUrl" target="_blank" style="color:#a78bfa;">@Model.LinkedInUrl</a></p>
            }
        </div>

        <div style="margin-top:28px;display:flex;justify-content:center;gap:12px;font-size:15px;">
            <a asp-action="Edit" asp-route-id="@Model.Id"
               style="background:transparent;color:#e9d5ff;padding:10px 18px;border-radius:12px;
               text-decoration:none;font-weight:600;border:1.5px solid #a855f7;transition:0.3s;"
               onmouseover="this.style.background='rgba(168,85,247,0.15)'"
               onmouseout="this.style.background='transparent'">Edit</a>

            @if (User.IsInRole("Admin"))
            {
                <button onclick="deleteDoctor('@Model.Id')"
                        style="background:linear-gradient(135deg,#ef4444,#dc2626);color:white;
                    padding:10px 18px;border-radius:12px;border:none;font-weight:600;cursor:pointer;
                    transition:0.3s;box-shadow:0 8px 20px rgba(239,68,68,0.3);"
                        onmouseover="this.style.transform='scale(1.05)'"
                        onmouseout="this.style.transform='scale(1)'">Delete</button>
            }

            <a asp-action="Index"
               style="background:linear-gradient(135deg,#7c3aed,#a855f7);color:white;
               padding:10px 18px;border-radius:12px;text-decoration:none;font-weight:600;
               transition:0.3s;box-shadow:0 8px 20px rgba(124,58,237,0.3);"
               onmouseover="this.style.transform='scale(1.05)'"
               onmouseout="this.style.transform='scale(1)'">Back</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
function uploadImage(input, doctorId) {
    if (!input.files || !input.files[0]) return;
    var file = input.files[0];
    if (!file.type.startsWith('image/')) { showToast('Please select an image file', true); return; }
    if (file.size > 5 * 1024 * 1024) { showToast('Image must be under 5MB', true); return; }

    var formData = new FormData();
    formData.append('image', file);

    fetch('/Doctor/upload-image/' + doctorId, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: formData
    })
    .then(r => { if (r.redirected || r.ok) {
        var reader = new FileReader();
        reader.onload = e => { document.getElementById('doctor-avatar').src = e.target.result; };
        reader.readAsDataURL(file);
        showToast('Photo updated!');
    }})
    .catch(() => showToast('Upload failed', true));
}

function deleteDoctor(doctorId) {
    if (!confirm('Delete this Doctor profile?')) return;
    fetch('/Doctor/delete/' + doctorId, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) { window.location.href = '/Doctor'; }
        else { showToast('Error: ' + data.message, true); }
    })
    .catch(() => showToast('Request failed', true));
}

function showToast(msg, isError) {
    var t = document.getElementById('toast-ajax');
    t.textContent = msg;
    t.style.background = isError ? '#ef4444' : '#7e22ce';
    t.style.display = 'block';
    setTimeout(() => { t.style.display = 'none'; }, 2500);
}
</script>
}
