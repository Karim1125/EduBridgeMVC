@{
    ViewData["Title"] = "Home";
}

<div class="slider_area ">
    <div class="single_slider d-flex align-items-center justify-content-center slider_bg_1">
        <div class="container">
            <div class="row align-items-center justify-content-center">

                <!-- Image -->
                <div class="col-xl-6 col-md-6">
                    <div class="illastrator_png">
                        <img src="~/img/banner/edu_ilastration.png" alt="">
                        </div>
                    </div>

                    <!-- Text -->
                    <div class="col-xl-6 col-md-6">
                        <div class="slider_info">

                            <h3>
                                Build Your Team <br>
                                Collaborate With <br>
                                Doctors & TAs
                            </h3>

                            <!-- Buttons -->
                            <div style="margin-top:20px;">

                                @if (string.IsNullOrEmpty(Context.Session.GetString("token")))
                                {
                                    <!-- BEFORE LOGIN -->
                                    <a asp-controller="Team" asp-action="Index" class="boxed_btn">
                                        Explore Teams
                                    </a>

                                    <a asp-controller="Auth" asp-action="Register" class="boxed_btn"
                                           style="margin-left:10px; background:#28a745;">
                                        Get Started
                                    </a>

                                    <a asp-controller="Auth" asp-action="Login" class="boxed_btn"
                                           style="margin-left:10px; background:#007bff;">
                                        Login
                                    </a>
                                }
                                else
                                {
                                    <!-- AFTER LOGIN (CENTERED EXPLORE ONLY) -->
                                    <div style="display:flex;
                                        justify-content:center;
                                        margin-top:10px;">

                                        <a asp-controller="Team" asp-action="Index" class="boxed_btn"
                                               style="padding:12px 30px;">
                                            Explore Teams
                                        </a>

                                    </div>
                                }

                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>