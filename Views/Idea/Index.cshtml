@model IEnumerable<EduBridgeMVC.Contracts.Idea.IdeaResponse>
@{
    var canCreateIdea = ViewBag.CanCreateIdea as bool? == true;
    var currentUserTeamId = ViewBag.CurrentUserTeamId as Guid?;
}

<div class="bradcam_area breadcam_bg overlay2" style="padding: 150px 0;">
    <h3 style="font-style: italic;">Library</h3>
</div>

<div class="about_area" style="min-height:100vh;
    background:linear-gradient(135deg,#f5f3ff,#ddd6fe,#c4b5fd,#a78bfa);padding:50px 0;">

    <div class="container">
        <div id="toast-ajax" style="display:none; position:fixed;top:100px;left:50%;transform:translateX(-50%);
            z-index:9999;background:#7e22ce;color:white;padding:14px 30px;border-radius:20px;font-weight:bold;"></div>

        @if (canCreateIdea || User.IsInRole("Admin"))
        {
            <div style="display:flex;justify-content:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:24px;">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="IdeaCategory" asp-action="Index"
                       style="background:linear-gradient(135deg,#0ea5e9,#06b6d4);color:white;
                       padding:11px 22px;border-radius:14px;text-decoration:none;font-weight:600;
                       font-size:15px;transition:0.25s;box-shadow:0 6px 18px rgba(14,165,233,0.3);
                       display:inline-flex;align-items:center;gap:8px;"
                       onmouseover="this.style.transform='translateY(-3px)'"
                       onmouseout="this.style.transform='translateY(0)'">
                        Categories
                    </a>

                    <a asp-controller="IdeaTag" asp-action="Index"
                       style="background:linear-gradient(135deg,#10b981,#059669);color:white;
                       padding:11px 22px;border-radius:14px;text-decoration:none;font-weight:600;
                       font-size:15px;transition:0.25s;box-shadow:0 6px 18px rgba(16,185,129,0.3);
                       display:inline-flex;align-items:center;gap:8px;"
                       onmouseover="this.style.transform='translateY(-3px)'"
                       onmouseout="this.style.transform='translateY(0)'">
                        Tags
                    </a>
                }

                @if (canCreateIdea)
                {
                    <a asp-action="Create"
                       style="background:linear-gradient(135deg,#7c3aed,#a855f7);color:white;
                       padding:11px 26px;border-radius:14px;text-decoration:none;font-weight:600;
                       font-size:15px;transition:0.25s;box-shadow:0 6px 18px rgba(124,58,237,0.35);
                       display:inline-flex;align-items:center;gap:8px;"
                       onmouseover="this.style.transform='translateY(-3px)'"
                       onmouseout="this.style.transform='translateY(0)'">
                        ＋ Submit Idea
                    </a>
                }
            </div>
        }

        <div class="row mt-2">
            @if (!Model.Any())
            {
                <div class="col-12" style="text-align:center;padding:40px;">
                    <p style="color:#7c3aed;font-size:18px;font-weight:500;">No ideas found in the library yet.</p>
                </div>
            }
            else
            {
                @foreach (var idea in Model)
                {
                    <div class="col-xl-6 col-md-12 mb-4" id="idea-@idea.Id">
                        <div style="display:flex;flex-direction:column;gap:15px;padding:20px;border-radius:22px;
                            background:linear-gradient(135deg,#35265f,#4a2a84,#5b21b6);
                            border:1px solid rgba(196,181,253,0.25);color:white;transition:0.25s ease;
                            box-shadow:0 12px 30px rgba(76,29,149,0.35);"
                             onmouseover="this.style.transform='translateY(-6px)';this.style.boxShadow='0 20px 50px rgba(124,58,237,0.45)'"
                             onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 12px 30px rgba(76,29,149,0.35)'">

                            <div>
                                <h5 style="margin:0;font-weight:600;color:#f5f3ff;margin-bottom:8px;">@idea.Title</h5>
                                <p style="margin:0;color:#c4b5fd;font-size:14px;line-height:1.5;">@idea.Description</p>
                            </div>

                            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                                <span style="display:inline-block;padding:4px 12px;border-radius:10px;
                                    background:rgba(196,181,253,0.15);color:#e9d5ff;font-size:12px;font-weight:500;">
                                    📁 @idea.CategoryName
                                </span>
                                @foreach (var tag in idea.Tags)
                                {
                                    <span style="display:inline-block;padding:4px 12px;border-radius:10px;
                                        background:rgba(168,85,247,0.2);color:#e9d5ff;font-size:12px;">
                                        #@tag.Name
                                    </span>
                                }
                            </div>

                            <div style="display:flex;align-items:center;justify-content:space-between;padding-top:10px;border-top:1px solid rgba(196,181,253,0.1);">
                                <span style="font-size:13px;color:#a78bfa;">Team: <strong>@idea.TeamName</strong></span>
                                <div style="display:flex;gap:8px;">
                                    <a asp-action="Details" asp-route-id="@idea.Id"
                                       style="background:linear-gradient(135deg,#7c3aed,#a855f7);color:white;
                                        padding:6px 14px;border-radius:10px;text-decoration:none;font-weight:500;font-size:13px;
                                        transition:0.25s;box-shadow:0 4px 12px rgba(124,58,237,0.3);"
                                       onmouseover="this.style.transform='scale(1.07)'"
                                       onmouseout="this.style.transform='scale(1)'">View</a>

                                    @if (User.IsInRole("Admin") || currentUserTeamId == idea.TeamId)
                                    {
                                        <a asp-action="Edit" asp-route-id="@idea.Id"
                                           style="background:linear-gradient(135deg,#0ea5e9,#06b6d4);color:white;
                                            padding:6px 14px;border-radius:10px;text-decoration:none;font-weight:500;font-size:13px;
                                            transition:0.25s;"
                                           onmouseover="this.style.transform='scale(1.07)'"
                                           onmouseout="this.style.transform='scale(1)'">Edit</a>

                                        <button onclick="deleteIdea('@idea.Id', this)"
                                                style="background:linear-gradient(135deg,#ef4444,#dc2626);color:white;
                                            padding:6px 14px;border-radius:10px;border:none;font-size:13px;
                                            font-weight:500;cursor:pointer;transition:0.25s;"
                                                onmouseover="this.style.transform='scale(1.07)'"
                                                onmouseout="this.style.transform='scale(1)'">Delete</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
function deleteIdea(ideaId, btn) {
    if (!confirm('Delete this Idea?')) return;
    btn.disabled = true;
    fetch('/Idea/delete/' + ideaId, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            var card = document.getElementById('idea-' + ideaId);
            if (card) {
                card.style.transition = 'opacity 0.4s';
                card.style.opacity = '0';
                setTimeout(() => { card.style.display = 'none'; }, 450);
            }
            showToast('Idea deleted successfully');
        } else {
            btn.disabled = false;
            showToast('Error: ' + data.message, true);
        }
    })
    .catch(() => { btn.disabled = false; showToast('Request failed', true); });
}

function showToast(msg, isError) {
    var t = document.getElementById('toast-ajax');
    t.textContent = msg;
    t.style.background = isError ? '#ef4444' : '#7e22ce';
    t.style.display = 'block';
    setTimeout(() => { t.style.display = 'none'; }, 2500);
}
</script>
}
