@model IEnumerable<EduBridgeMVC.Contracts.Notification.NotificationResponse>

@{
    var unreadCount = ViewBag.UnreadCount as int? ?? 0;
}

<div class="bradcam_area breadcam_bg overlay2" style="padding: 150px 0;">
    <h3 style="font-style: italic;">Notifications</h3>
</div>

<div class="about_area" style="min-height:100vh;
    background:linear-gradient(135deg,#f5f3ff,#ddd6fe,#c4b5fd,#a78bfa);padding:50px 0;">

    <div class="container">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:24px;">
            <div>
                <h4 style="margin:0;color:#4c1d95;font-weight:700;">Your Notifications</h4>
                <p style="margin:6px 0 0;color:#7c3aed;font-size:14px;">
                    @unreadCount unread notification@(unreadCount == 1 ? "" : "s")
                </p>
            </div>

            @if (unreadCount > 0)
            {
                <form asp-action="MarkAllAsRead" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            style="background:linear-gradient(135deg,#7c3aed,#a855f7);color:white;
                            padding:11px 22px;border-radius:14px;border:none;font-weight:600;
                            font-size:15px;cursor:pointer;box-shadow:0 6px 18px rgba(124,58,237,0.35);">
                        Mark All Read
                    </button>
                </form>
            }
        </div>

        <div class="row">
            @if (!Model.Any())
            {
                <div class="col-12" style="text-align:center;padding:50px;">
                    <p style="color:#7c3aed;font-size:18px;font-weight:500;">No notifications yet.</p>
                </div>
            }
            else
            {
                @foreach (var notification in Model)
                {
                    <div class="col-12 mb-3" id="notification-@notification.Id">
                        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:18px;
                            padding:20px;border-radius:18px;
                            background:@(notification.IsRead ? "rgba(255,255,255,0.74)" : "linear-gradient(135deg,#35265f,#4a2a84,#5b21b6)");
                            border:1px solid @(notification.IsRead ? "rgba(124,58,237,0.18)" : "rgba(196,181,253,0.25)");
                            color:@(notification.IsRead ? "#4c1d95" : "white");
                            box-shadow:0 10px 28px rgba(76,29,149,0.20);">

                            <div style="flex:1;min-width:0;">
                                <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:8px;">
                                    <span style="display:inline-block;padding:4px 10px;border-radius:10px;
                                        background:@(notification.IsRead ? "rgba(124,58,237,0.10)" : "rgba(196,181,253,0.16)");
                                        color:@(notification.IsRead ? "#6d28d9" : "#e9d5ff");
                                        font-size:12px;font-weight:700;">
                                        @notification.Type
                                    </span>

                                    @if (!notification.IsRead)
                                    {
                                        <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#22d3ee;"></span>
                                    }
                                </div>

                                <p style="margin:0;font-size:15px;line-height:1.6;color:inherit;">
                                    @notification.Message
                                </p>

                                <p style="margin:10px 0 0;font-size:12px;color:@(notification.IsRead ? "#7c3aed" : "#c4b5fd");">
                                    @notification.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy - hh:mm tt")
                                </p>
                            </div>

                            @if (!notification.IsRead)
                            {
                                <form asp-action="MarkAsRead" asp-route-id="@notification.Id" method="post" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            style="background:linear-gradient(135deg,#0ea5e9,#06b6d4);color:white;
                                            padding:8px 14px;border-radius:10px;border:none;font-weight:600;
                                            font-size:13px;cursor:pointer;white-space:nowrap;">
                                        Mark Read
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
