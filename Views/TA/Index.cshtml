@model IEnumerable<EduBridgeMVC.Contracts.TA.TAResponse>

<div class="bradcam_area breadcam_bg overlay2" style="padding: 150px 0;">
    <h3 style="font-style: italic;">Teaching Assistants</h3>
</div>

<div class="about_area" style="min-height:100vh;
    background:linear-gradient(135deg,#f5f3ff,#ddd6fe,#c4b5fd,#a78bfa);padding:50px 0;">

    <div class="container">
        <div id="toast-ajax" style="display:none; position:fixed;top:100px;left:50%;transform:translateX(-50%);
            z-index:9999;background:#7e22ce;color:white;padding:14px 30px;border-radius:20px;font-weight:bold;"></div>

        @if (User.IsInRole("Admin"))
        {
            <div style="text-align:right; margin-bottom:24px;">
                <a asp-action="Create"
                   style="background:linear-gradient(135deg,#7c3aed,#a855f7);color:white;
                   padding:11px 26px;border-radius:14px;text-decoration:none;font-weight:600;
                   font-size:15px;transition:0.25s;box-shadow:0 6px 18px rgba(124,58,237,0.35);
                   display:inline-flex;align-items:center;gap:8px;"
                   onmouseover="this.style.transform='translateY(-3px)'"
                   onmouseout="this.style.transform='translateY(0)'">
                    ＋ Add TA
                </a>
            </div>
        }

        <div class="row mt-4">
            @foreach (var ta in Model)
            {
                <div class="col-xl-6 col-md-12 mb-4" id="ta-@ta.Id">
                    <div style="display:flex;align-items:center;gap:18px;padding:20px;border-radius:22px;
                        background:linear-gradient(135deg,#35265f,#4a2a84,#5b21b6);
                        border:1px solid rgba(196,181,253,0.25);color:white;transition:0.25s ease;
                        box-shadow:0 12px 30px rgba(76,29,149,0.35);"
                         onmouseover="this.style.transform='translateY(-6px)';this.style.boxShadow='0 20px 50px rgba(124,58,237,0.45)'"
                         onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 12px 30px rgba(76,29,149,0.35)'">
                        <img src="@(ta.ProfileImageUrl ?? "/img/default.png")"
                             style="width:100px;height:100px;border-radius:50%;object-fit:cover;border:2px solid #c4b5fd;box-shadow:0 0 14px rgba(196,181,253,0.5);" />
                        <div style="flex:1;">
                            <h5 style="margin:0;font-weight:600;color:#f5f3ff;">@ta.FullName</h5>
                            <p style="margin:3px 0;color:#c4b5fd;font-size:14px;">@ta.Email</p>
                            <p style="margin:3px 0;display:inline-block;padding:3px 10px;border-radius:10px;
                                background:rgba(196,181,253,0.15);color:#e9d5ff;font-size:13px;">@ta.Department</p>
                        </div>
                        <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end;">
                            <a asp-action="Details" asp-route-id="@ta.Id"
                               style="background:linear-gradient(135deg,#7c3aed,#a855f7);color:white;
                                padding:8px 16px;border-radius:12px;text-decoration:none;font-weight:500;
                                transition:0.25s;box-shadow:0 6px 18px rgba(124,58,237,0.3);"
                               onmouseover="this.style.transform='scale(1.07)'"
                               onmouseout="this.style.transform='scale(1)'">View</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <button onclick="deleteTA('@ta.Id', this)"
                                        style="background:linear-gradient(135deg,#ef4444,#dc2626);color:white;
                                    padding:6px 14px;border-radius:12px;border:none;font-size:13px;
                                    font-weight:500;cursor:pointer;transition:0.25s;
                                    box-shadow:0 4px 12px rgba(239,68,68,0.3);"
                                        onmouseover="this.style.transform='scale(1.07)'"
                                        onmouseout="this.style.transform='scale(1)'">Delete</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
function deleteTA(taId, btn) {
    if (!confirm('Delete this TA? Their account will be disabled.')) return;
    btn.disabled = true;
    fetch('/Ta/delete/' + taId, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            var card = document.getElementById('ta-' + taId);
            if (card) {
                card.style.transition = 'opacity 0.4s, max-height 0.5s';
                card.style.opacity = '0';
                setTimeout(() => { card.style.display = 'none'; }, 450);
            }
            showToast('TA deleted successfully');
        } else {
            btn.disabled = false;
            showToast('Error: ' + data.message, true);
        }
    })
    .catch(() => { btn.disabled = false; showToast('Request failed', true); });
}
function showToast(msg, isError) {
    var t = document.getElementById('toast-ajax');
    t.textContent = msg;
    t.style.background = isError ? '#ef4444' : '#7e22ce';
    t.style.display = 'block';
    setTimeout(() => { t.style.display = 'none'; }, 2500);
}
</script>
}
