@using EduBridgeMVC.Abstractions.Consts
@model IEnumerable<EduBridgeMVC.Contracts.TA.TaRequestResponse>
@{
    var title = ViewData["ListTitle"] ?? "TA Requests";
    var taId = ViewData["TaId"] as Guid?;
}

<div class="bradcam_area breadcam_bg overlay2" style="padding:150px 0;text-align:center;">
    <h3 style="font-style: italic;">@title</h3>
</div>

<div class="about_area" style="min-height:100vh;background:linear-gradient(135deg,#f5f3ff,#ddd6fe,#c4b5fd,#a78bfa);padding:50px 0;">
    <div class="container">
        <div class="row">
            @if (!Model.Any())
            {
                <div class="col-12">
                    <div style="padding:28px;border-radius:22px;text-align:center;background:linear-gradient(135deg,#35265f,#4c1d95);color:#f5f3ff;">No TA requests found.</div>
                </div>
            }

            @foreach (var request in Model)
            {
                <div class="col-xl-6 col-md-12 mb-4">
                    <div style="padding:22px;border-radius:22px;background:linear-gradient(135deg,#35265f,#4a2a84,#5b21b6);color:white;box-shadow:0 12px 30px rgba(76,29,149,0.35);">
                        <div style="display:flex;justify-content:space-between;gap:12px;">
                            <div>
                                <h4 style="margin:0 0 8px;color:#f5f3ff;">@request.TeamName</h4>
                                <p style="margin:0;color:#c4b5fd;">TA: @request.TaName</p>
                            </div>
                            <span style="background:rgba(196,181,253,0.18);color:#e9d5ff;font-size:12px;padding:5px 12px;border-radius:10px;font-weight:700;">@request.Status</span>
                        </div>
                        <p style="margin:16px 0;color:#ede9fe;">@(request.Message ?? "No message.")</p>
                        @if (!string.IsNullOrWhiteSpace(request.ResponseMessage))
                        {
                            <p style="margin:0 0 16px;color:#c4b5fd;">Response: @request.ResponseMessage</p>
                        }

                        @if (request.Status == RequestStatus.Pending)
                        {
                            <div style="display:flex;gap:10px;flex-wrap:wrap;">
                                <form asp-action="Approve" asp-route-id="@request.Id" method="post" style="display:flex;gap:8px;flex:1;min-width:230px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="taId" value="@taId" />
                                    <input name="responseMessage" placeholder="Response" style="flex:1;padding:9px;border-radius:10px;border:1px solid #7c3aed;background:transparent;color:white;" />
                                    <button type="submit" style="background:#16a34a;color:white;border:none;border-radius:10px;padding:9px 14px;font-weight:600;">Approve</button>
                                </form>
                                <form asp-action="Reject" asp-route-id="@request.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="taId" value="@taId" />
                                    <button type="submit" style="background:#dc2626;color:white;border:none;border-radius:10px;padding:9px 14px;font-weight:600;">Remove</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
