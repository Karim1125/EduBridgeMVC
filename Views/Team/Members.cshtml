@using EduBridgeMVC.Abstractions.Consts
@model IEnumerable<EduBridgeMVC.Contracts.Team.TeamMemberResponse>
@{
    var teamId = (Guid)(ViewData["TeamId"] ?? Guid.Empty);
    var teamName = ViewData["TeamName"] as string ?? "Team";
    var leaderId = ViewData["LeaderId"] as string;
    var canManageMembers = ViewData["CanManageMembers"] as bool? ?? false;
}

<div class="bradcam_area breadcam_bg overlay2" style="padding:150px 0;text-align:center;">
    <h3 style="font-style: italic;">Team Members</h3>
</div>

<div class="about_area" style="min-height:100vh;background:linear-gradient(135deg,#f5f3ff,#ede9fe,#ddd6fe);padding:50px 0;">
    <div class="container">
        <div style="max-width:900px;margin:0 auto;">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:20px;">
                <div>
                    <h2 style="margin:0;color:#4c1d95;font-weight:800;">@teamName</h2>
                    <p style="margin:4px 0 0;color:#6d28d9;">View the people in this team.</p>
                </div>
                <a asp-action="Details" asp-route-id="@teamId"
                   style="background:transparent;color:#4c1d95;padding:10px 18px;border-radius:12px;text-decoration:none;font-weight:700;border:1.5px solid #7c3aed;">
                    Back to Team
                </a>
            </div>

            @if (!Model.Any())
            {
                <div style="padding:28px;border-radius:18px;text-align:center;background:#ffffff;color:#4c1d95;border:1px solid #c4b5fd;">
                    No members found.
                </div>
            }

            <div style="display:grid;grid-template-columns:1fr;gap:14px;">
                @foreach (var member in Model)
                {
                    var isLeader = member.UserId == leaderId || member.Role == MemberRole.Leader;

                    <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:18px;border-radius:18px;background:linear-gradient(135deg,#35265f,#4c1d95);color:white;box-shadow:0 12px 30px rgba(76,29,149,0.28);">
                        <div style="display:flex;align-items:center;gap:14px;min-width:240px;">
                            <img src="@(member.ProfileImageUrl ?? "/img/default.png")"
                                 style="width:64px;height:64px;border-radius:50%;object-fit:cover;border:2px solid #c4b5fd;" />
                            <div>
                                <h5 style="margin:0;color:#fff;font-weight:700;">@member.FullName</h5>
                                <p style="margin:4px 0;color:#ddd6fe;font-size:13px;">Joined @member.JoinedAt.ToLocalTime().ToString("MMM d, yyyy")</p>
                                <span style="display:inline-block;background:rgba(196,181,253,0.18);color:#f5f3ff;font-size:12px;padding:4px 10px;border-radius:10px;font-weight:700;">@member.Role</span>
                            </div>
                        </div>

                        <div style="display:flex;gap:10px;flex-wrap:wrap;">
                            @if (canManageMembers && !isLeader)
                            {
                                <form asp-action="AssignLeader" asp-route-id="@teamId" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@member.UserId" />
                                    <input type="hidden" name="fromMembers" value="true" />
                                    <button type="submit"
                                            style="background:transparent;color:#e9d5ff;padding:9px 14px;border-radius:12px;border:1.5px solid #a855f7;font-weight:700;cursor:pointer;">
                                        Make Leader
                                    </button>
                                </form>

                                <form asp-action="RemoveMember" asp-route-id="@teamId" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@member.UserId" />
                                    <input type="hidden" name="fromMembers" value="true" />
                                    <button type="submit"
                                            onclick="return confirm('Remove this member from the team?')"
                                            style="background:linear-gradient(135deg,#ef4444,#dc2626);color:white;padding:9px 14px;border-radius:12px;border:none;font-weight:700;cursor:pointer;">
                                        Remove
                                    </button>
                                </form>
                            }
                            else if (isLeader)
                            {
                                <span style="color:#c4b5fd;font-weight:700;padding:9px 0;">Current Leader</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
