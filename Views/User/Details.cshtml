@model EduBridgeMVC.Contracts.User.UserResponse

<div class="bradcam_area breadcam_bg overlay2 text-center" style="padding:150px 0;">
    <h3 style="color:white;font-weight:600;margin:0;font-style:italic;">User Details</h3>
</div>

<div class="about_area d-flex align-items-center justify-content-center" style="min-height:80vh;
    background:linear-gradient(135deg,#f5f3ff,#ddd6fe,#c4b5fd,#a78bfa);">

    <div id="toast-ajax" style="display:none; position:fixed;top:100px;left:50%;transform:translateX(-50%);
        z-index:9999;background:#7e22ce;color:white;padding:14px 30px;border-radius:20px;font-weight:bold;"></div>

    <div style="width:420px;padding:30px;border-radius:20px;
        background:linear-gradient(135deg,#35265f,#4a2a84,#5b21b6);
        border:4px dotted #a78bfa;text-align:center;
        box-shadow:0 20px 40px rgba(124,58,237,0.3);">

        <!-- Avatar + upload -->
        <div style="position:relative;display:inline-block;margin-bottom:10px;">
            <img id="user-avatar" src="@(Model.ProfileImageUrl ?? "/img/default.png")"
                 style="width:100px;height:100px;border-radius:50%;border:3px solid #A78BFA;
                 box-shadow:0 0 25px rgba(167,139,250,0.7);" />
            <label for="imgUpload" title="Change photo"
                   style="position:absolute;bottom:0;right:0;background:#7c3aed;
                   border-radius:50%;width:28px;height:28px;display:flex;align-items:center;
                   justify-content:center;cursor:pointer;border:2px solid white;">
                <span style="color:white;font-size:14px;">&#9998;</span>
            </label>
            <input id="imgUpload" type="file" accept="image/*" style="display:none;"
                   onchange="uploadImage(this, '@Model.Id')" />
        </div>

        <h3 style="color:#F5F5F5;">
            @Model.FirstName @Model.LastName
            @if (Model.IsDisabled)
            {
                <span style="background:#ef4444;color:white;font-size:12px;padding:2px 8px;
                    border-radius:8px;font-weight:600;vertical-align:middle;margin-left:6px;">DISABLED</span>
            }
        </h3>
        <p style="color:#C4B5FD;margin:5px 0;">@Model.Email</p>
        <p style="color:#A78BFA;font-weight:600;margin:5px 0;">@Model.Role</p>
        <p style="color:#9CA3AF;font-size:14px;margin-bottom:15px;">Joined: @Model.CreatedAt.ToShortDateString()</p>

        <div style="margin-top:15px;display:flex;justify-content:center;gap:10px;flex-wrap:wrap;">
            <a asp-action="Edit" asp-route-id="@Model.Id"
               style="background:linear-gradient(135deg,#7C3AED,#C084FC);color:white;
               padding:10px 18px;border-radius:12px;text-decoration:none;display:inline-block;transition:0.3s;"
               onmouseover="this.style.transform='translateY(-3px)'"
               onmouseout="this.style.transform='translateY(0)'">Edit</a>

            @if (User.IsInRole("Admin") && !Model.IsDisabled)
            {
                <button onclick="deleteUser('@Model.Id')"
                        style="background:#ef4444;color:white;padding:10px 18px;border-radius:12px;
                    border:none;cursor:pointer;transition:0.3s;"
                        onmouseover="this.style.transform='translateY(-3px)'"
                        onmouseout="this.style.transform='translateY(0)'">Disable</button>
            }

            <a asp-action="Index"
               style="background:transparent;color:#C084FC;border:1px solid #C084FC;
               padding:10px 18px;border-radius:12px;text-decoration:none;transition:0.3s;"
               onmouseover="this.style.background='#C084FC';this.style.color='white'"
               onmouseout="this.style.background='transparent';this.style.color='#C084FC'">Back</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
function uploadImage(input, userId) {
    if (!input.files || !input.files[0]) return;
    var file = input.files[0];
    if (!file.type.startsWith('image/')) { showToast('Please select an image file', true); return; }
    if (file.size > 5 * 1024 * 1024) { showToast('Image must be under 5MB', true); return; }

    var formData = new FormData();
    formData.append('image', file);

    fetch('/User/upload-image/' + userId, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: formData
    })
    .then(() => {
        var reader = new FileReader();
        reader.onload = e => { document.getElementById('user-avatar').src = e.target.result; };
        reader.readAsDataURL(file);
        showToast('Photo updated!');
    })
    .catch(() => showToast('Upload failed', true));
}

function deleteUser(userId) {
    if (!confirm('Disable this user? They will no longer be able to log in.')) return;
    fetch('/User/delete/' + userId, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) { window.location.reload(); }
        else { showToast('Error: ' + data.message, true); }
    })
    .catch(() => showToast('Request failed', true));
}

function showToast(msg, isError) {
    var t = document.getElementById('toast-ajax');
    t.textContent = msg;
    t.style.background = isError ? '#ef4444' : '#7e22ce';
    t.style.display = 'block';
    setTimeout(() => { t.style.display = 'none'; }, 2500);
}
</script>
}
