@model IEnumerable<UserResponse>

<div class="bradcam_area breadcam_bg overlay2" style="padding:150px 0; text-align:center;">
    <h3 style="font-style: italic;">Users</h3>
</div>

<div class="about_area" style="min-height:100vh;
    background:linear-gradient(135deg,#f5f3ff,#ddd6fe,#c4b5fd,#a78bfa);
    padding:50px 0;">

    <div class="container">
        <div id="toast-ajax" style="display:none; position:fixed;top:100px;left:50%;transform:translateX(-50%);
            z-index:9999;background:#7e22ce;color:white;
            padding:14px 30px;border-radius:20px;font-weight:bold;"></div>

        @if (User.IsInRole("Admin"))
        {
            <div style="text-align:right; margin-bottom:24px;">
                <a asp-action="Create"
                   style="background:linear-gradient(135deg,#7c3aed,#a855f7);color:white;
                   padding:11px 26px;border-radius:14px;text-decoration:none;font-weight:600;
                   font-size:15px;transition:0.25s;box-shadow:0 6px 18px rgba(124,58,237,0.35);
                   display:inline-flex;align-items:center;gap:8px;"
                   onmouseover="this.style.transform='translateY(-3px)'"
                   onmouseout="this.style.transform='translateY(0)'">
                    ＋ Add User
                </a>
            </div>
        }

        <div class="row mt-4">
            @foreach (var user in Model)
            {
                <div class="col-xl-6 col-md-12 mb-4" id="user-@user.Id"
                     style="@(user.IsDisabled ? "opacity:0.55;" : "")">
                    <div style="display:flex;align-items:center;gap:18px;padding:20px;border-radius:22px;
                        background:linear-gradient(135deg,#35265f,#4a2a84,#5b21b6);
                        border:1px solid rgba(196,181,253,0.25);color:white;transition:0.25s ease;
                        box-shadow:0 12px 30px rgba(76,29,149,0.35);"
                         onmouseover="this.style.transform='translateY(-6px)';this.style.boxShadow='0 20px 50px rgba(124,58,237,0.45)'"
                         onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 12px 30px rgba(76,29,149,0.35)'">
                        <img src="@(user.ProfileImageUrl ?? "/img/default.png")"
                             style="width:100px;height:100px;border-radius:50%;object-fit:cover;border:2px solid #c4b5fd;box-shadow:0 0 14px rgba(196,181,253,0.5);" />
                        <div style="flex:1;">
                            <h5 style="margin:0;font-weight:600;color:#f5f3ff;display:flex;align-items:center;gap:8px;">
                                @user.FirstName @user.LastName
                                @if (user.IsDisabled)
                                {
                                    <span style="background:#ef4444;color:white;font-size:11px;padding:2px 8px;border-radius:8px;font-weight:600;">DISABLED</span>
                                }
                            </h5>
                            <p style="margin:3px 0;color:#c4b5fd;font-size:14px;">@user.Email</p>
                            <p style="margin:3px 0;display:inline-block;padding:3px 10px;border-radius:10px;
                                background:rgba(196,181,253,0.15);color:#e9d5ff;font-size:13px;">@user.Role</p>
                        </div>
                        <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end;">
                            <a asp-action="Details" asp-route-id="@user.Id"
                               style="background:linear-gradient(135deg,#7c3aed,#a855f7);color:white;
                                padding:8px 16px;border-radius:12px;text-decoration:none;font-weight:500;
                                transition:0.25s;box-shadow:0 6px 18px rgba(124,58,237,0.3);white-space:nowrap;"
                               onmouseover="this.style.transform='scale(1.07)'"
                               onmouseout="this.style.transform='scale(1)'">View</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <button id="toggle-btn-@user.Id"
                                        onclick="toggleUser('@user.Id', this)"
                                        data-disabled="@user.IsDisabled.ToString().ToLower()"
                                        style="@(user.IsDisabled
                                            ? "background:linear-gradient(135deg,#16a34a,#22c55e);"
                                            : "background:linear-gradient(135deg,#ef4444,#dc2626);")
                                    color:white;padding:6px 14px;border-radius:12px;border:none;font-size:13px;
                                    font-weight:500;cursor:pointer;transition:0.25s;white-space:nowrap;
                                    box-shadow:@(user.IsDisabled ? "0 4px 12px rgba(34,197,94,0.35)" : "0 4px 12px rgba(239,68,68,0.3)");"
                                        onmouseover="this.style.transform='scale(1.07)'"
                                        onmouseout="this.style.transform='scale(1)'">
                                    @(user.IsDisabled ? "Enable" : "Disable")
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
function toggleUser(userId, btn) {
    var isDisabled = btn.getAttribute('data-disabled') === 'true';
    var action = isDisabled ? 'enable' : 'disable';
    if (!confirm((isDisabled ? 'Enable' : 'Disable') + ' this user?')) return;
    btn.disabled = true;
    fetch('/User/toggle-disable/' + userId, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.json())
    .then(data => {
        btn.disabled = false;
        if (data.success) {
            var nowDisabled = data.isDisabled;
            var card = document.getElementById('user-' + userId);

            // Update card opacity
            if (card) card.style.opacity = nowDisabled ? '0.55' : '1';

            // Update badge in name
            var nameEl = card ? card.querySelector('h5') : null;
            if (nameEl) {
                var badge = nameEl.querySelector('.disabled-badge');
                if (nowDisabled) {
                    if (!badge) {
                        badge = document.createElement('span');
                        badge.className = 'disabled-badge';
                        badge.textContent = 'DISABLED';
                        badge.style.cssText = 'background:#ef4444;color:white;font-size:11px;padding:2px 8px;border-radius:8px;font-weight:600;margin-left:8px;';
                        nameEl.appendChild(badge);
                    }
                } else {
                    if (badge) badge.remove();
                }
            }

            // Update button
            btn.setAttribute('data-disabled', nowDisabled ? 'true' : 'false');
            btn.textContent = nowDisabled ? 'Enable' : 'Disable';
            if (nowDisabled) {
                btn.style.background = 'linear-gradient(135deg,#16a34a,#22c55e)';
                btn.style.boxShadow = '0 4px 12px rgba(34,197,94,0.35)';
            } else {
                btn.style.background = 'linear-gradient(135deg,#ef4444,#dc2626)';
                btn.style.boxShadow = '0 4px 12px rgba(239,68,68,0.3)';
            }

            showToast('User ' + (nowDisabled ? 'disabled' : 'enabled') + ' successfully');
        } else {
            showToast('Error: ' + data.message, true);
        }
    })
    .catch(() => { btn.disabled = false; showToast('Request failed', true); });
}
function showToast(msg, isError) {
    var t = document.getElementById('toast-ajax');
    t.textContent = msg;
    t.style.background = isError ? '#ef4444' : '#7e22ce';
    t.style.display = 'block';
    setTimeout(() => { t.style.display = 'none'; }, 2500);
}
</script>
}
